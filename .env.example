# =============================================================================
# AuraReserve Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Only DATABASE_URL is required for development.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/aurareserve"

# Docker PostgreSQL (only needed if using docker-compose)
# POSTGRES_USER=aurareserve
# POSTGRES_PASSWORD=change-me-to-a-strong-password
# POSTGRES_DB=aurareserve

# Seed database on first run (set to true, run once, then remove)
# SEED_DATABASE=false

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Required in production (min 32 characters). 
# generate via: openssl rand -base64 32
# BETTER_AUTH_SECRET="your-secret-key-at-least-32-characters-long"

# App URLs — REQUIRED for Docker deployments behind a reverse proxy (Traefik, etc.)
# Set these to your public-facing URL (e.g. https://reserve.example.com)
# The auth client auto-detects the URL from the browser, so only server-side vars are needed.
# NEXT_PUBLIC_APP_URL="https://reserve.example.com"
# BETTER_AUTH_URL="https://reserve.example.com"

# Enable/disable email+password login (default: true)
# AUTH_CREDENTIALS_ENABLED=true

# -----------------------------------------------------------------------------
# OAuth Providers (optional)
# -----------------------------------------------------------------------------

# Google OAuth
# AUTH_GOOGLE_ENABLED=false
# NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Azure AD OAuth
# AUTH_AZURE_ENABLED=false
# NEXT_PUBLIC_AUTH_AZURE_ENABLED=false
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""
# AZURE_AD_TENANT_ID=""

# -----------------------------------------------------------------------------
# Encryption & Security
# -----------------------------------------------------------------------------
# Encryption key for integration config (falls back to BETTER_AUTH_SECRET)
# PLUGIN_CONFIG_ENCRYPTION_KEY=""

# CSRF secret (falls back to BETTER_AUTH_SECRET)
# CSRF_SECRET=""

# Cron job authentication (min 16 characters)
# CRON_SECRET=""

# -----------------------------------------------------------------------------
# Integrations
# -----------------------------------------------------------------------------
# Avalanche blockchain signer
# AVALANCHE_SIGNER_PRIVATE_KEY=""

# System user for automated operations (default: system@aurareserve.io)
# SYSTEM_USER_EMAIL="system@aurareserve.io"

# -----------------------------------------------------------------------------
# Job Queue (Redis)
# -----------------------------------------------------------------------------
# Required for cron scheduling, retries, and background job processing
# Format: redis://[:password@]host[:port][/db]
# Examples:
#   redis://localhost:6379                              (no auth)
#   redis://:mysecretpassword@localhost:6379            (password only)
#   redis://myuser:mysecretpassword@localhost:6379      (user + password, Redis 6+ ACL)
#   rediss://:mysecretpassword@redis.example.com:6380   (TLS)
# REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Signer Service
# -----------------------------------------------------------------------------
# JSON-RPC signing service for blockchain transactions
# Defaults to embedded signer at /api/internal/signer/sign
# SIGNER_SERVICE_URL="http://localhost:3000/api/internal/signer/sign"
# SIGNER_SERVICE_TOKEN="your-signer-token-at-least-16-chars"

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
# NODE_ENV=development
# PORT=3000
# SELF_HOSTED=false
# BILLING_ENABLED=false
